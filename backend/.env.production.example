# Продакшен-настройки. Скопируй в .env и заполни. НЕ коммить .env в git.

# --- обязательно ---
# Сгенерируй так:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ_МИНИМУМ_32_СИМВОЛА
POSTGRES_PASSWORD=ЗАМЕНИ_НА_СИЛЬНЫЙ_ПАРОЛЬ_БАЗЫ

# Публичный адрес (для ссылок в письмах). Домен с https.
PUBLIC_BASE_URL=https://nasosolingo.ru

# Разрешённые источники для CORS (обычно тот же домен). Через запятую.
CORS_ORIGINS=https://nasosolingo.ru

# E-mail'ы с доступом к /admin (аналитика), через запятую.
ADMIN_EMAILS=you@example.ru

# --- почта (иначе письма пишутся в лог) ---
# Пример для Яндекс 360: smtp.yandex.ru, порт 465, SMTP_SSL=true
# Пример для обычного 587 STARTTLS: оставь порт 587
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=no-reply@nasosolingo.ru
SMTP_PASSWORD=пароль_приложения_почты
SMTP_FROM=no-reply@nasosolingo.ru

# База/имя (можно оставить по умолчанию)
POSTGRES_USER=nasos
POSTGRES_DB=nasos

# --- Telegram Mini App (необязательно) ---
# Токен бота от @BotFather. Пусто → вход через Telegram выключен, работает только веб.
# Час (0-23, по времени сервера) для ежедневных напоминаний в Telegram.
TELEGRAM_REMINDER_HOUR=18
TELEGRAM_BOT_TOKEN=
